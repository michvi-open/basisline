{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michvi.com/open-source/basisline/schema/v0.1/decision-receipt.schema.json",
  "title": "Basisline Decision Receipt",
  "description": "v0.1 — captures the evidence, assumptions, and decision itself. Immutable once created. See spec/v0.1.md section 4.1.",
  "type": "object",
  "properties": {
    "basisline_version": {
      "type": "string",
      "const": "0.1"
    },
    "record_type": {
      "type": "string",
      "const": "receipt"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^bl_[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]+$"
    },
    "decision": {
      "type": "object",
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "required": ["summary", "context", "owner", "date", "confidence"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "metric": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "freshness_days": { "type": "integer", "minimum": 0 }
        },
        "required": ["source", "metric", "value", "unit", "freshness_days"],
        "additionalProperties": false
      }
    },
    "evidence_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_conflicts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "review_after_days": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "object",
      "properties": {
        "supersedes": {
          "type": ["string", "null"]
        },
        "related_receipt_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "basisline_version",
    "record_type",
    "receipt_id",
    "decision",
    "evidence",
    "evidence_as_of",
    "assumptions",
    "review_after_days"
  ],
  "additionalProperties": false
}
